# anthropic (default) | google (AI Studio, OpenAI-compatible endpoint) | openrouter
CARDCOST_PROVIDER=anthropic
# model id for the chosen provider, e.g. claude-sonnet-5-5 | gemini-3.8-flash | google/gemini-3.8-flash
CARDCOST_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# EUR per million tokens, used for agent_run.cost_eur
CARDCOST_PRICE_IN_EUR_PER_MTOK=
CARDCOST_PRICE_OUT_EUR_PER_MTOK=
CARDCOST_WEBHOOK_SECRET=
CARDCOST_DB=cardcost.db
